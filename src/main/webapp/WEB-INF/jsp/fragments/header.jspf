<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimTrade</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/simtrade-nse.css">
</head>
<body>
    <!-- Permanent Disclaimer Banner -->
    <div style="background: var(--tv-blue); color: white; text-align: center; padding: 6px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;">
        Paper trading simulator. Virtual money. Mock prices. Not real market data.
    </div>
    <nav class="tv-top-nav">
        <div class="tv-nav-left">
            <a href="${pageContext.request.contextPath}/" class="tv-brand">
                <div class="tv-logo-icon">S</div>
                SimTrade
            </a>
            <c:if test="${not empty sessionScope.AuthUser}">
                <div class="nav-divider"></div>
                <c:choose>
                    <c:when test="${sessionScope.AuthUser.role == 'ADMIN'}">
                        <a href="${pageContext.request.contextPath}/admin/dashboard" class="tv-icon-btn">Dashboard</a>
                        <a href="${pageContext.request.contextPath}/admin/users" class="tv-icon-btn">Users</a>
                        <a href="${pageContext.request.contextPath}/admin/stocks" class="tv-icon-btn">Stocks</a>
                        <a href="${pageContext.request.contextPath}/admin/prices" class="tv-icon-btn">Prices</a>
                        <a href="${pageContext.request.contextPath}/admin/trades" class="tv-icon-btn">Trades</a>
                    </c:when>
                    <c:otherwise>
                        <a href="${pageContext.request.contextPath}/app/dashboard" class="tv-icon-btn">Dashboard</a>
                        <a href="${pageContext.request.contextPath}/app/market" class="tv-icon-btn">Market</a>
                        <a href="${pageContext.request.contextPath}/app/portfolio" class="tv-icon-btn">Portfolio</a>
                        <a href="${pageContext.request.contextPath}/app/history" class="tv-icon-btn">History</a>
                    </c:otherwise>
                </c:choose>
            </c:if>
        </div>
        
        <div class="tv-nav-right">
            <c:if test="${not empty sessionScope.AuthUser}">
                <a href="${pageContext.request.contextPath}/app/profile" class="tv-icon-btn">
                    👤 <c:out value="${sessionScope.AuthUser.username}"/>
                </a>
                <form action="${pageContext.request.contextPath}/logout" method="post" style="display:inline; margin-left: 8px;">
                    <button type="submit" class="tv-trade-btn" style="background: var(--tv-border); color: var(--tv-text-primary);">Logout</button>
                </form>
            </c:if>
            <c:if test="${empty sessionScope.AuthUser}">
                <a href="${pageContext.request.contextPath}/login" class="tv-icon-btn">Login</a>
                <a href="${pageContext.request.contextPath}/register" class="tv-trade-btn">Register</a>
            </c:if>
        </div>
    </nav>
    <div class="tv-main-container">
        <section class="tv-chart-container">
            <!-- Flash Messages -->
            <c:if test="${not empty sessionScope.flashSuccess}">
                <div class="flash-message success">
                    <c:out value="${sessionScope.flashSuccess}"/>
                </div>
                <c:remove var="flashSuccess" scope="session"/>
            </c:if>
            <c:if test="${not empty sessionScope.flashError}">
                <div class="flash-message error">
                    <c:out value="${sessionScope.flashError}"/>
                </div>
                <c:remove var="flashError" scope="session"/>
            </c:if>
